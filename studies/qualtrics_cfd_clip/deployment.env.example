# Copy to your deployment secret/config store; do not commit the real secret.
LINEUP_SIGNING_SECRET=replace-with-at-least-32-random-bytes

CFD_REPOSITORY_ROOT=/srv/pyWitnessAI
# Mount the approved CFD media read-only; the service also verifies bytes on every GET.
CFD_IMAGE_ROOT=/srv/pyWitnessAI/data/CFD Version 3.0/Images
CFD_CLIP_INDEX_DIR=/srv/pyWitnessAI/build/qualtrics_cfd_clip/clip_index_vit_l_14
CFD_CLIP_SELECTION_PROFILE=/srv/pyWitnessAI/studies/qualtrics_cfd_clip/contrast_profile_live_v1.json
CFD_CLIP_MODEL=clip-ViT-L-14
CFD_CLIP_MODEL_REVISION=1b4b2e899178706d1b9905460ac21de1e0ba86a5
# Prepare this snapshot with python -m studies.qualtrics_cfd_clip.bootstrap_model before startup.
# The basename and complete snapshot-content digest are fail-closed checks.
CFD_CLIP_LOCAL_MODEL_PATH=/srv/models/clip-ViT-L-14/1b4b2e899178706d1b9905460ac21de1e0ba86a5
# Used by the optional bootstrap command; keep download metadata outside the snapshot.
CFD_CLIP_MODEL_CACHE=/srv/models/.hub-cache
CFD_CLIP_DEVICE=cpu

QUALTRICS_ALLOWED_ORIGINS=https://bristolexppsych.eu.qualtrics.com
LINEUP_IMAGE_TTL_SECONDS=7200
CLIP_INFERENCE_TIMEOUT_SECONDS=25
CLIP_MAX_CONCURRENT_INFERENCE=1
CLIP_RESULT_CACHE_SIZE=512
